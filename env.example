# F1 Prediction System - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to git (it's in .gitignore)

# ============================================
# Chatbot LLM Configuration
# ============================================

# Groq API (Recommended - Free tier available)
# Get your API key from: https://console.groq.com/
# Leave empty to use Ollama (local) instead
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (optional - defaults to llama-3.1-8b-instant)
# Options: llama-3.1-8b-instant (fast), llama-3.3-70b-versatile (best quality), mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-8b-instant

# Ollama Model (only used if GROQ_API_KEY is not set)
# Default: deepseek-coder:6.7b
# Make sure you've run: ollama pull deepseek-coder:6.7b
CHABOT_MODEL=deepseek-coder:6.7b

# ============================================
# API Configuration
# ============================================

# Backend API Port (default: 8000)
API_PORT=8000

# Frontend API URL (for CORS and API client)
# Default: http://localhost:8000
VITE_API_URL=http://localhost:8000

